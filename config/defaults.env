PROJECT_DIR="${PROJECT_DIR:-/home/ding/MR_GWAS_Pipeline}"

CONDA_SH="${CONDA_SH:-/home/ding/miniconda3/etc/profile.d/conda.sh}"
CONDA_ENV="${CONDA_ENV:-GWAS}"
R_LIB_PATH="${R_LIB_PATH:-/home/ding/R/4.4.1_MR}"

ORG_DATA_DIR="${ORG_DATA_DIR:-${PROJECT_DIR}/data/Org}"
STANDARDIZED_OUTPUT_DIR="${STANDARDIZED_OUTPUT_DIR:-${PROJECT_DIR}/data/standardized}"
EXP_OUTPUT_DIR="${EXP_OUTPUT_DIR:-${PROJECT_DIR}/data/exp}"
OUT_OUTPUT_DIR="${OUT_OUTPUT_DIR:-${PROJECT_DIR}/data/out}"
RESULTS_DIR="${RESULTS_DIR:-${PROJECT_DIR}/results}"
REFERENCE_DIR="${REFERENCE_DIR:-${PROJECT_DIR}/data/reference}"

# 兼容旧变量名
EXPOSURE_OUTPUT_DIR="${EXPOSURE_OUTPUT_DIR:-${EXP_OUTPUT_DIR}}"
OUTCOME_OUTPUT_DIR="${OUTCOME_OUTPUT_DIR:-${OUT_OUTPUT_DIR}}"

PLINK_BIN="${PLINK_BIN:-/home/ding/miniconda3/envs/GWAS/bin/plink}"
CLUMP_BFILE="${CLUMP_BFILE:-/home/ding/MR_LPA/Ref/g1000_eur/g1000_eur_colon}"
FRQ_REFERENCE="${FRQ_REFERENCE:-${REFERENCE_DIR}/$(basename "${CLUMP_BFILE}").frq.tsv.gz}"
CLUMP_R2="${CLUMP_R2:-0.01}"
CLUMP_KB="${CLUMP_KB:-1000}"
CLUMP_P1="${CLUMP_P1:-5e-4}"
CLUMP_POP="${CLUMP_POP:-EUR}"

MVMR_GLOBAL_CLUMP_PLINK="${MVMR_GLOBAL_CLUMP_PLINK:-${PLINK_BIN}}"
MVMR_GLOBAL_CLUMP_BFILE="${MVMR_GLOBAL_CLUMP_BFILE:-${CLUMP_BFILE}}"
MVMR_GLOBAL_CLUMP_R2="${MVMR_GLOBAL_CLUMP_R2:-${CLUMP_R2}}"
MVMR_GLOBAL_CLUMP_KB="${MVMR_GLOBAL_CLUMP_KB:-${CLUMP_KB}}"
MVMR_GLOBAL_CLUMP_P1="${MVMR_GLOBAL_CLUMP_P1:-1}"
